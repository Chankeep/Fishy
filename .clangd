CompileFlags:
  Add:
    - "/std:c++latest"
    - "-Wno-unknown-attributes"

Diagnostics:
  UnusedIncludes: None
  Suppress:
    # C++23 compatibility issues with clangd
    - "invalid_consteval_call"
    - "no_member_template"
    - "no_member"
    - "typecheck_nonviable_condition"  # std::expected issues
    - "err_undeclared_var_use"         # byte/variant not found
    - "unknown_typename"               # VoidResult etc
    - "*"  # Nuclear option: suppress all clangd errors (use MSVC for real errors)
